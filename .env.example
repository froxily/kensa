# Copy to .env (git-ignored) and change the password. Never commit .env.
# All values here are local-development placeholders, not secrets.

# --- PostgreSQL (docker compose `db` service, bound to 127.0.0.1:5433) ---
POSTGRES_USER=kensa
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=kensa
KENSA_DATABASE_URL=postgresql+psycopg://kensa:change-me-local-only@127.0.0.1:5433/kensa

# --- Application ---
KENSA_ENV=development
KENSA_LOG_LEVEL=INFO
KENSA_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# --- Inference (local Ollama; never set OLLAMA_HOST to 0.0.0.0) ---
KENSA_INFERENCE_PROVIDER=ollama
KENSA_OLLAMA_BASE_URL=http://127.0.0.1:11434
KENSA_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Measured in M0 (eval/reports/m0-model-benchmark-numgpu99.md): 8192 fits fully on a 4 GB GPU when
# all layers are requested on the GPU; use 6144 if other apps use VRAM; never >= 12288 (spills).
KENSA_LLM_NUM_CTX=8192
KENSA_LLM_NUM_GPU=99

# --- Embeddings (M2; measured: GPU 41 chunks/s vs CPU 0.8 on the 4 GB laptop) ---
KENSA_EMBEDDING_PROVIDER=ollama
KENSA_EMBEDDING_MODEL=qwen3-embedding:0.6b
KENSA_LLM_TIMEOUT_SECONDS=120

# --- Tracing: LangSmith is a paid service and stays off ---
LANGSMITH_TRACING=false
# Local OpenTelemetry traces (M5): written to .telemetry/ (git-ignored); nothing is sent anywhere.
KENSA_TELEMETRY_ENABLED=true

# --- GitHub (M4 only). Leave empty. If ever used, it must be a fine-grained,
# --- read-only, public-repositories-only token approved by the owner.
KENSA_GITHUB_TOKEN=

# --- History matching (v1.1, D-057): experimental and off. When true, the History panel and
# --- the dashboard show earlier failures as recurrences or similar failures. It missed its
# --- held-out recall targets (eval/reports/v11-v4-history-test.md); precision was met.
KENSA_HISTORY_MATCHING=false
