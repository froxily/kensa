# Normalise line endings in the repo (instead of changing global core.autocrlf).
* text=auto eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.webm binary
*.mp4 binary
*.zip binary
*.woff binary
*.woff2 binary
